<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_crm_case_opportunities_filter_inherit_stale_watchdog" model="ir.ui.view">
        <field name="name">crm.lead.search.stale.watchdog</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.view_crm_case_opportunities_filter"/>
        <field name="arch" type="xml">
            <filter name="open_opportunities" position="after">
                <filter string="Stale Opportunities" name="filter_stale_opportunities"
                        domain="[('is_stale', '=', True)]"
                        help="Opportunities that haven't been updated within the configured threshold"/>
            </filter>
            <filter name="lostreason" position="after">
                <filter string="Stale" name="groupby_is_stale" context="{'group_by': 'is_stale'}"/>
            </filter>
        </field>
    </record>
</odoo>
