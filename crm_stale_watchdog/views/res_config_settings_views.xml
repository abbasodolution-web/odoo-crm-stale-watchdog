<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_stale_watchdog" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.crm.stale.watchdog</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="crm.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='crm']/block[1]" position="after">
                <block title="Stale Opportunity Watchdog" name="crm_stale_watchdog_block">
                    <setting id="crm_stale_watchdog_threshold"
                             help="Opportunities untouched for this many days are flagged as stale and their salesperson gets a follow-up reminder">
                        <field name="crm_stale_watchdog_threshold_days"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
